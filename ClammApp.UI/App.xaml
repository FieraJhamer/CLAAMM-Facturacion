<Application x:Class="ClammApp.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <Color x:Key="ColorPrimario">#C8A13E</Color>
        <Color x:Key="ColorPrimarioOscuro">#A9882F</Color>
        <Color x:Key="ColorPrimarioHover">#B08D2E</Color>
        <Color x:Key="ColorGrafito">#2E3238</Color>
        <Color x:Key="ColorGrafitoClaro">#3A4048</Color>
        <Color x:Key="ColorFondo">#F2F3F5</Color>
        <Color x:Key="ColorBorde">#D5D8DC</Color>
        <SolidColorBrush x:Key="BrochaPrimaria" Color="{StaticResource ColorPrimario}"/>
        <SolidColorBrush x:Key="BrochaPrimariaOscura" Color="{StaticResource ColorPrimarioOscuro}"/>
        <SolidColorBrush x:Key="BrochaPrimariaHover" Color="{StaticResource ColorPrimarioHover}"/>
        <SolidColorBrush x:Key="BrochaGrafito" Color="{StaticResource ColorGrafito}"/>
        <SolidColorBrush x:Key="BrochaGrafitoClaro" Color="{StaticResource ColorGrafitoClaro}"/>
        <SolidColorBrush x:Key="BrochaFondo" Color="{StaticResource ColorFondo}"/>
        <SolidColorBrush x:Key="BrochaBorde" Color="{StaticResource ColorBorde}"/>

        <Style x:Key="TituloPantalla" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource BrochaGrafito}"/>
            <Setter Property="Margin" Value="0,0,0,18"/>
        </Style>

        <Style x:Key="Etiqueta" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#4A5568"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrochaBorde}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>

        <Style x:Key="BotonBase" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BotonPrincipal" TargetType="Button" BasedOn="{StaticResource BotonBase}">
            <Setter Property="Background" Value="{StaticResource BrochaPrimaria}"/>
            <Setter Property="Foreground" Value="{StaticResource BrochaGrafito}"/>
        </Style>

        <Style x:Key="BotonSecundario" TargetType="Button" BasedOn="{StaticResource BotonBase}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource BrochaGrafito}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrochaBorde}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="BotonPeligro" TargetType="Button" BasedOn="{StaticResource BotonBase}">
            <Setter Property="Background" Value="{StaticResource BrochaGrafito}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style x:Key="BotonNavegacion" TargetType="Button" BasedOn="{StaticResource BotonBase}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#D6DAE0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="18,12"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                Margin="8,2">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#26C8A13E"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#40C8A13E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource BrochaBorde}"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrochaBorde}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="{StaticResource BrochaFondo}"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="RowHeight" Value="34"/>
            <Setter Property="ColumnHeaderHeight" Value="36"/>
            <Setter Property="RowStyle">
                <Setter.Value>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#26C8A13E"/>
                                <Setter Property="Foreground" Value="{StaticResource BrochaGrafito}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#14C8A13E"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="ColumnHeaderStyle">
                <Setter.Value>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{StaticResource BrochaGrafito}"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="8,0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
