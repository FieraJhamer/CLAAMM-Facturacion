<Window x:Class="ClammApp.UI.Views.IncrementoPreciosWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Incremento global de precios" Width="460" Height="260"
        MinWidth="380" MinHeight="220"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Subir precios" Style="{StaticResource TituloPantalla}"/>
            <TextBlock Text="Ingresá el porcentaje de aumento que se aplicará a todos los ítems."
                       TextWrapping="Wrap" FontSize="13" Foreground="#4A5568" Margin="0,0,0,16"/>
            <TextBlock Text="Porcentaje (%)" Style="{StaticResource Etiqueta}"/>
            <TextBox x:Name="TxtPorcentaje" Height="36"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancelar" Style="{StaticResource BotonSecundario}"
                    Margin="0,0,10,0" Click="BtnCancelar_Click"/>
            <Button Content="Aplicar a todos" Style="{StaticResource BotonPrincipal}"
                    Click="BtnAplicar_Click"/>
        </StackPanel>
    </Grid>
</Window>
