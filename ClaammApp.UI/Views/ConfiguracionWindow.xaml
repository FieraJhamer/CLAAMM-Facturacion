<Window x:Class="ClaammApp.UI.Views.ConfiguracionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configuración" Width="560" Height="640"
        MinWidth="480" MinHeight="480"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Configuración" Style="{StaticResource TituloPantalla}"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,10,0">
                <TextBlock Text="Datos de la empresa (aparecen en el PDF)" FontSize="14" FontWeight="Bold"
                           Foreground="{StaticResource BrochaGrafito}" Margin="0,0,0,12"/>

                <TextBlock Text="Responsable" Style="{StaticResource Etiqueta}"/>
                <TextBox x:Name="TxtResponsable" Height="34" Margin="0,0,0,12" MaxLength="120"/>

                <TextBlock Text="CUIT" Style="{StaticResource Etiqueta}"/>
                <TextBox x:Name="TxtCuit" Height="34" Margin="0,0,0,12" MaxLength="20"/>

                <TextBlock Text="Dirección" Style="{StaticResource Etiqueta}"/>
                <TextBox x:Name="TxtDireccion" Height="34" Margin="0,0,0,12" MaxLength="200"/>

                <TextBlock Text="Ubicación (ciudad y provincia)" Style="{StaticResource Etiqueta}"/>
                <TextBox x:Name="TxtUbicacion" Height="34" Margin="0,0,0,12" MaxLength="120"/>

                <TextBlock Text="Teléfono" Style="{StaticResource Etiqueta}"/>
                <TextBox x:Name="TxtTelefono" Height="34" Margin="0,0,0,12" MaxLength="50"/>

                <TextBlock Text="Email" Style="{StaticResource Etiqueta}"/>
                <TextBox x:Name="TxtEmail" Height="34" MaxLength="100"/>
                <TextBlock Text="El logo se toma automáticamente del archivo logo.png ubicado junto a la aplicación."
                           FontSize="11" Foreground="#718096" Margin="0,6,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancelar" Style="{StaticResource BotonSecundario}"
                    Margin="0,0,10,0" Click="BtnCancelar_Click"/>
            <Button Content="Guardar" Style="{StaticResource BotonPrincipal}" Click="BtnGuardar_Click"/>
        </StackPanel>
    </Grid>
</Window>
