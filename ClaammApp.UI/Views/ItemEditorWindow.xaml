<Window x:Class="ClaammApp.UI.Views.ItemEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Item de precio" Width="520" Height="430"
        MinWidth="460" MinHeight="400"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock x:Name="TituloVentana" Text="Nuevo ítem" Style="{StaticResource TituloPantalla}"/>

            <TextBlock Text="Descripción" Style="{StaticResource Etiqueta}"/>
            <TextBox x:Name="TxtDescripcion" Height="34" Margin="0,0,0,14" MaxLength="200"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Unidad" Style="{StaticResource Etiqueta}"/>
                    <ComboBox x:Name="CboUnidad" Height="34" IsEditable="True"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Precio unitario" Style="{StaticResource Etiqueta}"/>
                    <TextBox x:Name="TxtPrecio" Height="34" MaxLength="14" PreviewTextInput="TxtPrecio_PreviewTextInput"/>
                </StackPanel>
            </Grid>

            <TextBlock Text="Rubro" Style="{StaticResource Etiqueta}" Margin="0,14,0,4"/>
            <ComboBox x:Name="CboRubro" Height="34" IsEditable="True"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="BtnCancelar" Content="Cancelar" Style="{StaticResource BotonSecundario}"
                    Margin="0,0,10,0" Click="BtnCancelar_Click"/>
            <Button x:Name="BtnGuardar" Content="Guardar" Style="{StaticResource BotonPrincipal}"
                    IsDefault="True" Click="BtnGuardar_Click"/>
        </StackPanel>
    </Grid>
</Window>
