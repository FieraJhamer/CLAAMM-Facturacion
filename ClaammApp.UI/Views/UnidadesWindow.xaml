<Window x:Class="ClaammApp.UI.Views.UnidadesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Unidades de medida" Width="460" Height="520"
        MinWidth="420" MinHeight="400"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Unidades de medida" Style="{StaticResource TituloPantalla}"/>

        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource BrochaBorde}"
                BorderThickness="1" CornerRadius="8" Margin="0,0,0,12">
            <ListBox x:Name="ListaUnidades" FontSize="14" BorderThickness="0"
                     SelectionChanged="ListaUnidades_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Nombre}" Padding="4,4"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <StackPanel Grid.Row="2">
            <TextBlock Text="Nombre de la unidad" Style="{StaticResource Etiqueta}"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TxtNombre" Height="34" MaxLength="20"/>
                <Button Grid.Column="2" x:Name="BtnAgregar" Content="Agregar" Style="{StaticResource BotonPrincipal}"
                        Height="34" Padding="16,6" Click="BtnAgregar_Click"/>
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <Button x:Name="BtnEditar" Content="Renombrar" Style="{StaticResource BotonSecundario}"
                        Margin="0,0,10,0" IsEnabled="False" Click="BtnEditar_Click"/>
                <Button x:Name="BtnEliminar" Content="Eliminar" Style="{StaticResource BotonPeligro}"
                        IsEnabled="False" Click="BtnEliminar_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
