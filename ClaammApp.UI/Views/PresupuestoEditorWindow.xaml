<Window x:Class="ClaammApp.UI.Views.PresupuestoEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Presupuesto"
        WindowState="Maximized"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock x:Name="TituloVentana" Text="Presupuesto" Style="{StaticResource TituloPantalla}"/>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="7*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="Cliente" Style="{StaticResource Etiqueta}"/>
                    <TextBox x:Name="TxtCliente" Height="34" MaxLength="120" TextChanged="TxtCliente_TextChanged"/>
                </StackPanel>

                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="Fecha" Style="{StaticResource Etiqueta}"/>
                    <DatePicker x:Name="FechaPicker" Height="34" FontSize="14" VerticalContentAlignment="Center" SelectedDateChanged="FechaPicker_SelectedDateChanged"/>
                </StackPanel>

                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="Descuento (%)" Style="{StaticResource Etiqueta}"/>
                    <TextBox x:Name="TxtDescuento" Height="34" PreviewTextInput="TxtDescuento_PreviewTextInput" TextChanged="TxtDescuento_TextChanged"/>
                </StackPanel>

                <Border Background="White" BorderBrush="{StaticResource BrochaBorde}"
                        BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,4,0,0">
                    <StackPanel>
                        <TextBlock Text="Buscar ítem por nombre" Style="{StaticResource Etiqueta}"/>
                        <TextBox x:Name="TxtBuscarItem" Height="34" PreviewKeyDown="TxtBuscarItem_PreviewKeyDown" TextChanged="TxtBuscarItem_TextChanged"/>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Cantidad" Style="{StaticResource Etiqueta}"/>
                                <TextBox x:Name="TxtCantidad" Height="34" Text="1" MaxLength="12" PreviewTextInput="TxtCantidad_PreviewTextInput"/>
                            </StackPanel>
                            <Button Grid.Column="2" Content="Agregar ítem" Style="{StaticResource BotonPrincipal}"
                                    VerticalAlignment="Bottom" Height="34" Padding="16,6" Click="BtnAgregar_Click"/>
                        </Grid>

                        <Grid Margin="0,10,0,0">
                            <ListBox x:Name="ListaResultados" MaxHeight="160"
                                     Visibility="Collapsed"
                                     MouseDoubleClick="ListaResultados_MouseDoubleClick" BorderBrush="{StaticResource BrochaBorde}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <TextBlock Text="{Binding PrecioTexto}" FontWeight="Bold" Foreground="{StaticResource BrochaPrimaria}"
                                                       DockPanel.Dock="Right" Margin="10,0,0,0"/>
                                            <TextBlock TextWrapping="Wrap">
                                                <Run Text="{Binding Codigo, Mode=OneWay}" FontWeight="SemiBold"/>
                                                <Run Text=" - "/>
                                                <Run Text="{Binding Descripcion, Mode=OneWay}"/>
                                            </TextBlock>
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <Border x:Name="MensajeSinResultados" Visibility="Collapsed" Background="White"
                                    BorderBrush="{StaticResource BrochaBorde}" BorderThickness="1" CornerRadius="6" Padding="12,8">
                                <TextBlock Text="No se encontró ningún ítem que coincida" FontSize="13" Foreground="#718096"/>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BrochaBorde}"
                        BorderThickness="1" CornerRadius="8" Margin="0,0,0,12">
                    <DataGrid x:Name="GridLineas" Margin="12">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Descripción" Binding="{Binding Descripcion}" Width="*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Unidad" Binding="{Binding Unidad}" Width="70" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Cantidad" Binding="{Binding CantidadTexto, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                            <DataGridTextColumn Header="Precio Unitario" Binding="{Binding PrecioUnitarioTexto}" Width="130" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Total" Binding="{Binding TotalTexto}" Width="140" IsReadOnly="True"/>
                            <DataGridTemplateColumn Header="" Width="86">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Eliminar" Style="{StaticResource BotonSecundario}"
                                                Padding="8,2" FontSize="12" HorizontalAlignment="Center"
                                                Click="BtnEliminarLinea_Click"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <DockPanel Grid.Row="1">
                    <Border Background="{StaticResource BrochaPrimaria}" CornerRadius="8" Padding="18,10"
                            HorizontalAlignment="Right">
                        <TextBlock x:Name="TxtTotal" Text="TOTAL: $ 0,00" FontSize="20" FontWeight="Bold" Foreground="{StaticResource BrochaGrafito}"/>
                    </Border>
                </DockPanel>
            </Grid>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancelar" Style="{StaticResource BotonSecundario}"
                    Margin="0,0,10,0" Click="BtnCancelar_Click"/>
            <Button Content="Guardar" Style="{StaticResource BotonSecundario}"
                    Margin="0,0,10,0" Click="BtnGuardar_Click"/>
            <Button Content="Guardar y exportar PDF" Style="{StaticResource BotonPrincipal}"
                    Click="BtnGuardarYExportar_Click"/>
        </StackPanel>
    </Grid>
</Window>
