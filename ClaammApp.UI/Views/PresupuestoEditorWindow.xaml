<Window x:Class="ClaammApp.UI.Views.PresupuestoEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Presupuesto" Width="1180" Height="800"
        MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock x:Name="TituloVentana" Text="Presupuesto" Style="{StaticResource TituloPantalla}"/>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="170"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Cliente" Style="{StaticResource Etiqueta}"/>
                    <TextBox x:Name="TxtCliente" Height="34"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Fecha" Style="{StaticResource Etiqueta}"/>
                    <DatePicker x:Name="FechaPicker" Height="34" FontSize="14" VerticalContentAlignment="Center"/>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource BrochaBorde}"
                    BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Buscar ítem por nombre" Style="{StaticResource Etiqueta}"/>
                            <TextBox x:Name="TxtBuscarItem" Height="34" KeyUp="TxtBuscarItem_KeyUp"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Cantidad" Style="{StaticResource Etiqueta}"/>
                            <TextBox x:Name="TxtCantidad" Height="34" Text="1"/>
                        </StackPanel>

                        <Button Grid.Column="4" Content="Agregar ítem" Style="{StaticResource BotonPrincipal}"
                                VerticalAlignment="Bottom" Height="34" Padding="16,6" Click="BtnAgregar_Click"/>
                    </Grid>

                    <ListBox x:Name="ListaResultados" Margin="0,10,0,0" MaxHeight="120"
                             Visibility="Collapsed"
                             MouseDoubleClick="ListaResultados_MouseDoubleClick" BorderBrush="{StaticResource BrochaBorde}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <TextBlock Text="{Binding PrecioTexto}" FontWeight="Bold" Foreground="{StaticResource BrochaPrimaria}"
                                               DockPanel.Dock="Right" Margin="10,0,0,0"/>
                                    <TextBlock>
                                        <Run Text="{Binding Codigo, Mode=OneWay}" FontWeight="SemiBold"/>
                                        <Run Text=" - "/>
                                        <Run Text="{Binding Descripcion, Mode=OneWay}"/>
                                    </TextBlock>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource BrochaBorde}"
                    BorderThickness="1" CornerRadius="8" Margin="0,0,0,12">
                <DataGrid x:Name="GridLineas" Margin="12">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Descripción" Binding="{Binding Descripcion}" Width="*" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Unidad" Binding="{Binding Unidad}" Width="70" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Cantidad" Binding="{Binding CantidadTexto}" Width="100"/>
                        <DataGridTextColumn Header="Precio Unitario" Binding="{Binding PrecioUnitarioTexto}" Width="130" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Total" Binding="{Binding TotalTexto}" Width="140" IsReadOnly="True"/>
                        <DataGridTemplateColumn Header="" Width="86">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Eliminar" Style="{StaticResource BotonSecundario}"
                                            Padding="8,2" FontSize="12" HorizontalAlignment="Center"
                                            Click="BtnEliminarLinea_Click"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <DockPanel Grid.Row="3">
                <Border Background="{StaticResource BrochaPrimaria}" CornerRadius="8" Padding="18,10"
                        HorizontalAlignment="Right">
                    <TextBlock x:Name="TxtTotal" Text="TOTAL: $ 0,00" FontSize="20" FontWeight="Bold" Foreground="{StaticResource BrochaGrafito}"/>
                </Border>
            </DockPanel>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancelar" Style="{StaticResource BotonSecundario}"
                    Margin="0,0,10,0" Click="BtnCancelar_Click"/>
            <Button Content="Guardar" Style="{StaticResource BotonSecundario}"
                    Margin="0,0,10,0" Click="BtnGuardar_Click"/>
            <Button Content="Guardar y exportar PDF" Style="{StaticResource BotonPrincipal}"
                    Click="BtnGuardarYExportar_Click"/>
        </StackPanel>
    </Grid>
</Window>
