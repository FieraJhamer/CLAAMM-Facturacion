<UserControl x:Class="ClaammApp.UI.Views.ItemsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="28">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock Text="Ítems de precios" Style="{StaticResource TituloPantalla}"/>
        </DockPanel>

        <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource BrochaBorde}"
                BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Buscar ítem" Style="{StaticResource Etiqueta}"/>
                <TextBox x:Name="TxtBuscar" Height="36" KeyUp="TxtBuscar_KeyUp"/>
            </StackPanel>
        </Border>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button x:Name="BtnUnidades" Content="Unidades" Style="{StaticResource BotonSecundario}"
                    Margin="0,0,10,0" Click="BtnUnidades_Click"/>
            <Button x:Name="BtnEliminar" Content="Eliminar" Style="{StaticResource BotonPeligro}"
                    Margin="0,0,10,0" Click="BtnEliminar_Click"/>
            <Button x:Name="BtnEditar" Content="Editar" Style="{StaticResource BotonSecundario}"
                    Margin="0,0,10,0" Click="BtnEditar_Click"/>
            <Button x:Name="BtnNuevo" Content="Nuevo ítem" Style="{StaticResource BotonPrincipal}"
                    Click="BtnNuevo_Click"/>
        </StackPanel>

        <Border Background="White" BorderBrush="{StaticResource BrochaBorde}"
                BorderThickness="1" CornerRadius="8">
            <DataGrid x:Name="GridItems"
                      IsReadOnly="True"
                      MouseDoubleClick="GridItems_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Código" Binding="{Binding Codigo}" Width="110"/>
                    <DataGridTextColumn Header="Descripción" Binding="{Binding Descripcion}" Width="*"/>
                    <DataGridTextColumn Header="Unidad" Binding="{Binding Unidad}" Width="70"/>
                    <DataGridTextColumn Header="Precio" Binding="{Binding PrecioTexto}" Width="130" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Rubro" Binding="{Binding Rubro}" Width="140"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</UserControl>
